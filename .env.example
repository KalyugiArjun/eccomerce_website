APP_NAME="ShopKart"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE="Asia/Kolkata"
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_IN

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database Configuration (Supports SQLite or MySQL)
DB_CONNECTION=sqlite
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=shopkart
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync

CACHE_STORE=database

# Mail Configuration
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="support@shopkart.in"
MAIL_FROM_NAME="ShopKart Marketplace"

# Indian Payment Gateway Integration
RAZORPAY_KEY_ID=rzp_test_YourKeyHere
RAZORPAY_KEY_SECRET=YourSecretHere
STRIPE_KEY=
STRIPE_SECRET=

# AI Shopping Assistant & Vision Service
AI_PROVIDER=local_semantic # options: local_semantic, gemini, openai
GEMINI_API_KEY=
OPENAI_API_KEY=

# Maps (Leaflet + OpenStreetMap is default and requires 0 API keys)
MAP_DEFAULT_LAT=26.8467
MAP_DEFAULT_LNG=80.9462
MAP_DEFAULT_CITY="Lucknow"
MAP_DEFAULT_PINCODE="226001"
